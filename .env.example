# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=driftguard
POSTGRES_PASSWORD=driftguard_secret
POSTGRES_DB=driftguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://driftguard:driftguard_secret@localhost:5432/driftguard

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── OpenAI (optional — app runs in offline mode if not set) ─────────────────
# Needed for: LLM-as-judge quality scoring, agent loop (diagnose + fix proposal)
# Without this key, the app uses heuristic stubs that still produce realistic data.
OPENAI_API_KEY=sk-...

# LLM models (only used when OPENAI_API_KEY is set)
JUDGE_MODEL=gpt-4o-mini
AGENT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small   # falls back to sentence-transformers

# ─── DriftGuard Backend ───────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ─── Scoring thresholds ───────────────────────────────────────────────────────
DRIFT_ALERT_ZSCORE=2.0          # z-score threshold to flag drift anomaly
QUALITY_ALERT_THRESHOLD=5.0     # quality score below this triggers alert
ROLLING_WINDOW_SIZE=50          # number of recent calls used for baseline
